# Copy this file to .env and enter the two required email settings.
ZEPTOMAIL_SEND_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=

# Optional: use the API endpoint for your ZeptoMail region.
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Optional integrations. Turnstile needs both a site key and a secret.
# VITE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=
# TELEGRAM_BOT_TOKEN=
# VITE_TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# GOOGLE_AI_API_KEY=

# For clients on another device, bind the host ports and replace SERVER_IP with
# the Docker host address they can reach. Expose ports 3000, 3210 and 3211.
# ANKAN_BIND_ADDRESS=0.0.0.0
# ANKAN_WEB_ORIGIN=http://SERVER_IP:3000
# ANKAN_CONVEX_ORIGIN=http://SERVER_IP:3210
# ANKAN_CONVEX_SITE_ORIGIN=http://SERVER_IP:3211
# Remote MCP clients and Telegram webhooks require HTTPS public origins.
# ANKAN_MCP_ORIGIN=https://mcp.example.com
